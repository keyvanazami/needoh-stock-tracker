# NeeDoh Stock Tracker config. Every var here is OPTIONAL — the app runs and
# serves the dashboard with none of them set. Copy to .env and edit.
#
#   cp .env.example .env
#   python -m needoh_tracker            # http://localhost:3100

# Port to serve on (default 3100).
PORT=3100

# How often to poll all sources, in seconds (min 60; default 600 = 10 min).
POLL_INTERVAL_S=600

# Which stores to check, comma-separated. Default: all.
# Options: schylling,target,walmart,amazon
ENABLED_STORES=schylling,target,walmart,amazon

# Public Instagram accounts to scan for restock hints, comma-separated.
INSTAGRAM_ACCOUNTS=schylling

# Stores to phone automatically when a restock is detected (subset of above).
CALL_STORES=

# ---- Email notifications (SMTP). Gmail: use an App Password. ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=you@gmail.com
# SMTP_TO=you@gmail.com,partner@example.com

# ---- Web push (desktop/browser notifications). Generate a VAPID keypair. ----
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---- Real phone calls via Twilio. Needs all four + STORE_PHONE_NUMBERS. ----
# Without these, calls are recorded as "simulated" with the spoken script.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551230000
# Public URL where Twilio can reach this server's /twiml/* webhooks (e.g. ngrok).
# PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
# Per-store destination numbers: store=number,store=number
# STORE_PHONE_NUMBERS=target=+15551234567,walmart=+15557654321

# Optional: override Target's public RedSky web key if it rotates.
# TARGET_API_KEY=
